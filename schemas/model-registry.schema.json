{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mlipflow:schema:model-registry:1.0",
  "title": "MLIPFlow task-aware model registry",
  "description": "Models are routed using explicit task/scenario benchmark artifacts and project policies; no globally preferred family is encoded.",
  "type": "object",
  "required": ["schema_version", "registry_id", "models"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": 1},
    "registry_id": {"$ref": "#/$defs/identifier"},
    "description": {"type": "string"},
    "models": {
      "type": "array",
      "items": {"$ref": "#/$defs/model"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "non_empty_string": {"type": "string", "minLength": 1},
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "artifact_reference": {
      "type": "object",
      "required": ["uri"],
      "properties": {
        "uri": {"$ref": "#/$defs/non_empty_string"}
      },
      "additionalProperties": false
    },
    "benchmark": {
      "type": "object",
      "required": [
        "run_id",
        "task",
        "scenario",
        "artifact",
        "validation_samples",
        "metrics"
      ],
      "properties": {
        "run_id": {"$ref": "#/$defs/non_empty_string"},
        "task": {"$ref": "#/$defs/identifier"},
        "scenario": {"$ref": "#/$defs/identifier"},
        "artifact": {"$ref": "#/$defs/artifact_reference"},
        "validation_samples": {"type": "integer", "minimum": 1},
        "metrics": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {"$ref": "#/$defs/identifier"},
          "additionalProperties": {"type": "number"}
        },
        "units": {
          "type": "object",
          "propertyNames": {"$ref": "#/$defs/identifier"},
          "additionalProperties": {"type": "string"}
        }
      },
      "additionalProperties": false
    },
    "model": {
      "type": "object",
      "required": [
        "id",
        "family",
        "version",
        "artifact",
        "elements",
        "tasks",
        "recommended_tasks",
        "training_data",
        "benchmarks",
        "compatibility",
        "limitations"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "family": {"$ref": "#/$defs/non_empty_string"},
        "version": {"$ref": "#/$defs/non_empty_string"},
        "artifact": {"$ref": "#/$defs/artifact_reference"},
        "elements": {
          "type": "array",
          "items": {"type": "string", "pattern": "^[A-Z][a-z]?$"},
          "minItems": 1,
          "uniqueItems": true
        },
        "tasks": {
          "type": "array",
          "items": {"$ref": "#/$defs/identifier"},
          "minItems": 1,
          "uniqueItems": true
        },
        "recommended_tasks": {
          "type": "array",
          "items": {"$ref": "#/$defs/identifier"},
          "uniqueItems": true,
          "description": "Evidence-backed recommendations; supported tasks remain the broader eligibility set."
        },
        "training_data": {"$ref": "#/$defs/artifact_reference"},
        "benchmarks": {
          "type": "array",
          "items": {"$ref": "#/$defs/benchmark"},
          "minItems": 1
        },
        "compatibility": {
          "type": "object",
          "required": ["environments", "backends"],
          "properties": {
            "environments": {
              "type": "array",
              "items": {"$ref": "#/$defs/non_empty_string"},
              "uniqueItems": true
            },
            "backends": {
              "type": "array",
              "items": {"$ref": "#/$defs/non_empty_string"},
              "uniqueItems": true
            }
          },
          "additionalProperties": false
        },
        "limitations": {
          "type": "array",
          "items": {"$ref": "#/$defs/non_empty_string"},
          "minItems": 1
        }
      },
      "additionalProperties": false
    }
  }
}
